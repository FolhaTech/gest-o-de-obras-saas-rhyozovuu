{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "functions": {
    "api/gateway.ts": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/rest/v1/:__vp*", "destination": "/api/gateway?__svc=rest&__p=:__vp*" },
    { "source": "/auth/v1/:__vp*", "destination": "/api/gateway?__svc=auth&__p=:__vp*" },
    { "source": "/storage/v1/:__vp*", "destination": "/api/gateway?__svc=storage&__p=:__vp*" },
    { "source": "/functions/v1/:__vp*", "destination": "/api/gateway?__svc=functions&__p=:__vp*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
